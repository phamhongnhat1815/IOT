# MongoDB Community Server installed on this computer.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=signal_lab
RETENTION_DAYS=7
MQTT_HOST=YOUR_MQTT_HOST
MQTT_PORT=8883
MQTT_TOPIC=iot/+/raw
MQTT_USER=YOUR_MQTT_USERNAME
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
MQTT_TLS=true
MQTT_CA_FILE=data/certs/mqtt-ca.pem
MQTT_CLIENT_ID=signal-lab-CHANGE-TO-UNIQUE-ID
